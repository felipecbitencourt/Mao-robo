{
  "name": "mao-robo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/logic.test.mjs --log-level=warning && node node_modules/.cache/logic.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "^1.0.8",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
